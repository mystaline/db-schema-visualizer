{
  "name": "@schemaviz/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "schemaviz-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "build": "esbuild src/stdio.ts src/http.ts --bundle --platform=node --format=esm --outdir=dist --external:@modelcontextprotocol/sdk --external:zod --external:typescript",
    "build:worker": "esbuild src/worker.ts --bundle --platform=browser --format=esm --outfile=dist/worker.js --external:fs --external:os --external:path --external:perf_hooks",
    "type-check": "tsc --noEmit",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev:worker": "wrangler dev",
    "deploy": "pnpm build:worker && wrangler deploy",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@schemaviz/core": "workspace:*",
    "typescript": "^5.6.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "esbuild": "^0.28.1",
    "vitest": "^4.1.3",
    "wrangler": "^4.114.0"
  }
}
